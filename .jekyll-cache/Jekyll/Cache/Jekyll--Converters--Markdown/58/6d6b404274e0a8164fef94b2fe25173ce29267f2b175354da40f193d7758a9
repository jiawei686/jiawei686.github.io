  memory_limit: "1G"
  cpu_limit: 0.8
  max_concurrent_requests: 4

logging:
  level: "INFO"
  file: "~/.openclaw/logs/openclaw.log"
</span><span class="no">EOF
</span>        <span class="p">;;</span>
    <span class="s2">"pi2"</span><span class="p">)</span>
        <span class="nb">echo</span> <span class="s2">"Setting up for Raspberry Pi 2/Zero 2 W"</span>
        <span class="nb">cat</span> <span class="o">&gt;</span> ~/.openclaw/config.yaml <span class="o">&lt;&lt;</span> <span class="sh">'</span><span class="no">EOF</span><span class="sh">'
